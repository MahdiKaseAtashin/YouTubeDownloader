<Window x:Class="App.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:App.UI.ViewModels"
        xmlns:b="clr-namespace:App.UI.Behaviors"
        xmlns:conv="clr-namespace:App.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Height="820"
        Width="1080"
        MinHeight="640"
        MinWidth="880"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Foreground}">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:ConsoleLogLine}">
            <TextBlock FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,2"
                       Text="{Binding FormattedLine}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource App.Foreground}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStdErr}" Value="True">
                                <Setter Property="Foreground" Value="#FFFF5C5C" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VideoFormatDisplay}">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="YouTube Downloader"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding AppSubtitle, Mode=OneWay}"
                           Opacity="0.7"
                           Margin="0,6,0,0"
                           FontSize="13" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="Dark mode"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- URL input -->
                <Border Grid.Row="0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Video URL"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBox Grid.Row="1"
                                 MinHeight="52"
                                 FontSize="15"
                                 Padding="10,8"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Supports youtube.com/watch, youtu.be/…, embed, and m.youtube.com" />
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,14,0,0">
                            <Button Content="Paste from clipboard"
                                    Command="{Binding PasteFromClipboardCommand}"
                                    Padding="14,8"
                                    Margin="0,0,10,0" />
                            <Button Content="Fetch info"
                                    Command="{Binding FetchInfoCommand}"
                                    Padding="18,8"
                                    FontWeight="SemiBold"
                                    Background="{DynamicResource App.Accent}"
                                    Foreground="White"
                                    BorderThickness="0" />
                            <TextBlock Text="Invalid URL"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#FFFF6B6B"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding IsUrlValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fetching skeleton -->
                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        Visibility="{Binding IsFetching, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Loading preview…"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />
                        <ProgressBar Height="8"
                                     IsIndeterminate="True" />
                    </StackPanel>
                </Border>

                <!-- Preview card -->
                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Padding="0"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Border CornerRadius="8"
                                    ClipToBounds="True"
                                    Background="#22000000"
                                    Height="158">
                                <Image Source="{Binding VideoInfo.Thumbnail}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding VideoInfo.HasThumbnail, Converter={StaticResource BoolToVis}}" />
                            </Border>
                            <TextBlock Text="No thumbnail"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.5"
                                       Visibility="{Binding VideoInfo.HasThumbnail, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </Grid>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBox Text="{Binding VideoInfo.Title, Mode=OneWay}"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                            <StackPanel Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <TextBlock FontSize="14"
                                           Opacity="0.8"
                                           VerticalAlignment="Center"
                                           Text="Channel:" />
                                <TextBox Margin="6,0,0,0"
                                         Text="{Binding VideoInfo.ChannelName, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Opacity="0.8" />
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0"
                                        Orientation="Horizontal">
                                <TextBlock FontSize="14"
                                           Opacity="0.8"
                                           VerticalAlignment="Center"
                                           Text="Duration:" />
                                <TextBox Margin="6,0,0,0"
                                         Text="{Binding VideoInfo.DurationDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Opacity="0.8" />
                            </StackPanel>
                            <TextBlock Margin="0,14,0,4"
                                       Text="Stream / format"
                                       FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding VideoInfo.Formats}"
                                      SelectedItem="{Binding VideoInfo.SelectedFormat}"
                                      MinWidth="320"
                                      HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Download options -->
                <Border Grid.Row="3"
                        Margin="0,14,0,0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Download options"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <UniformGrid Grid.Row="1"
                                     Rows="1"
                                     Columns="3"
                                     Margin="0,0,0,14">
                            <CheckBox Content="Download video"
                                      IsChecked="{Binding Options.DownloadVideo, Mode=TwoWay}"
                                      Margin="0,0,12,0" />
                            <CheckBox Content="Download thumbnail"
                                      IsChecked="{Binding Options.DownloadThumbnail, Mode=TwoWay}"
                                      Margin="0,0,12,0" />
                            <CheckBox Content="Download subtitles"
                                      IsChecked="{Binding Options.DownloadSubtitles, Mode=TwoWay}" />
                        </UniformGrid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Container"
                                           Opacity="0.75"
                                           Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Options.VideoContainers}"
                                          SelectedItem="{Binding Options.SelectedVideoContainer, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Quality"
                                           Opacity="0.75"
                                           Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Options.QualityOptions}"
                                          SelectedItem="{Binding Options.SelectedQuality, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Subtitle language"
                                           Opacity="0.75"
                                           Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding VideoInfo.SubtitleLanguages}"
                                          SelectedItem="{Binding VideoInfo.SelectedSubtitleLanguage, Mode=TwoWay}"
                                          IsEnabled="{Binding IsSubtitlePickerEnabled}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- YouTube sign-in -->
                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="YouTube sign-in" FontWeight="SemiBold" />
                                <TextBlock Text="For age-restricted videos and bot checks. Sign in with your normal browser — no password is stored in this app."
                                           FontSize="12"
                                           Opacity="0.7"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="10,6"
                                    VerticalAlignment="Top"
                                    Background="#220078D4"
                                    CornerRadius="8">
                                <TextBlock Text="{Binding Auth.SignInStateDisplay, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <CheckBox Content="Use sign-in for restricted videos"
                                  IsChecked="{Binding Auth.UseSignIn, Mode=TwoWay}"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{Binding Auth.StatusMessage, Mode=OneWay}"
                                   FontSize="12"
                                   Opacity="0.85"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10"
                              Visibility="{Binding Auth.ShowBrowserFields, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Browser" Opacity="0.75" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Auth.Browsers}"
                                          SelectedItem="{Binding Auth.SelectedBrowser, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Account" Opacity="0.75" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Auth.Profiles}"
                                          SelectedItem="{Binding Auth.SelectedProfile, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10"
                              Visibility="{Binding Auth.ShowCookieFields, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Auth.CookieFilePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="14,8"
                                    Content="Browse…"
                                    Command="{Binding Auth.BrowseCookieFileCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Open YouTube in browser"
                                    Padding="14,8"
                                    Margin="0,0,10,0"
                                    Command="{Binding Auth.OpenYouTubeCommand}" />
                            <Button Content="Test connection"
                                    Padding="14,8"
                                    FontWeight="SemiBold"
                                    Background="{DynamicResource App.Accent}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Command="{Binding Auth.TestConnectionCommand}" />
                            <ProgressBar Width="80"
                                         Height="8"
                                         Margin="16,0,0,0"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="True"
                                         Visibility="{Binding Auth.IsChecking, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Expander Header="Advanced"
                                  IsExpanded="{Binding Auth.IsAdvancedExpanded, Mode=TwoWay}">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Use cookie file instead of browser (advanced)"
                                          IsChecked="{Binding Auth.UseCookieFile, Mode=TwoWay}"
                                          Margin="0,0,0,10" />
                                <StackPanel Visibility="{Binding Auth.ShowBrowserFields, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Manual profile name (only if your account is not listed)"
                                               FontSize="12"
                                               Opacity="0.75"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Auth.ManualProfileOverride, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10" />
                                </StackPanel>
                                <TextBlock Text="Tip: Export cookies in Netscape format only if browser sign-in does not work."
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Output folder -->
                <Border Grid.Row="5"
                        Margin="0,14,0,0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Save to folder"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox MinHeight="36"
                                     VerticalContentAlignment="Center"
                                     Padding="8,4"
                                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="Browse…"
                                    Margin="10,0,0,0"
                                    Padding="16,8"
                                    Command="{Binding BrowseOutputFolderCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="2"
                                   Margin="0,8,0,0"
                                   Foreground="#FFFF6B6B"
                                   FontSize="12"
                                   Text="Folder not found — pick a valid path."
                                   Visibility="{Binding IsOutputFolderValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>

                <!-- Batch download -->
                <Border Grid.Row="6"
                        Margin="0,14,0,0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Batch download"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock FontSize="12"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="One YouTube link per line. Each item saves to a subfolder named 1-video-title, 2-another-title, … under the folder above." />
                        <TextBox MinHeight="120"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding BatchUrlsText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,8,0,8"
                                   FontSize="12"
                                   Opacity="0.75"
                                   Text="{Binding BatchLinkCountLabel}" />
                        <Button Content="Batch download"
                                HorizontalAlignment="Left"
                                Padding="20,10"
                                FontWeight="SemiBold"
                                Background="{DynamicResource App.Accent}"
                                Foreground="White"
                                BorderThickness="0"
                                Command="{Binding BatchDownloadCommand}" />
                    </StackPanel>
                </Border>

                <!-- Download CTA -->
                <Border Grid.Row="7"
                        Margin="0,14,0,0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2">
                            <TextBlock Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <ProgressBar Height="12"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}" />
                        </StackPanel>
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Content="Download"
                                Padding="28,12"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Background="{DynamicResource App.Accent}"
                                Foreground="White"
                                BorderThickness="0"
                                Command="{Binding DownloadCommand}" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,14,0,0"
                                Content="Cancel"
                                Padding="20,12"
                                Command="{Binding CancelDownloadCommand}" />
                    </Grid>
                </Border>

                <!-- Activity log -->
                <Border Grid.Row="8"
                        Margin="0,14,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True"
                                   Margin="4,0,4,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Clear log"
                                    Padding="12,6"
                                    Command="{Binding ClearLogCommand}" />
                            <TextBlock Text="Activity"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox MinHeight="160"
                                     AcceptsReturn="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     Text="{Binding ActivityLogText, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
