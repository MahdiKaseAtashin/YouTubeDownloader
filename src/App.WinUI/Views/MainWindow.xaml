<Window
    x:Class="Yt.Client.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YouTube Downloader">
    <Grid x:Name="RootGrid" Padding="16">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="App.Background" Color="#F3F3F3" />
                        <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="App.Border" Color="#D0D0D0" />
                        <SolidColorBrush x:Key="App.Accent" Color="#0078D4" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="App.Background" Color="#F3F3F3" />
                        <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="App.Border" Color="#D0D0D0" />
                        <SolidColorBrush x:Key="App.Accent" Color="#0078D4" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="App.Background" Color="#1E1E1E" />
                        <SolidColorBrush x:Key="App.Surface" Color="#2D2D2D" />
                        <SolidColorBrush x:Key="App.Border" Color="#3C3C3C" />
                        <SolidColorBrush x:Key="App.Accent" Color="#60CDFD" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.Background>
            <ThemeResource ResourceKey="App.Background" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image
                    Width="44"
                    Height="44"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"
                    Source="{ThemeResource Icon.Brand.44}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="YouTube Downloader" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        Opacity="0.7"
                        Text="Paste a link, Fetch info, choose what to save, Download" />
                </StackPanel>
            </StackPanel>
            <CheckBox
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="Dark mode"
                IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="16"
                    Background="{ThemeResource App.Surface}"
                    BorderBrush="{ThemeResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Video URL" />
                        <TextBox
                            Grid.Row="1"
                            MinHeight="52"
                            Padding="10,8"
                            VerticalContentAlignment="Center"
                            AcceptsReturn="False"
                            FontSize="15"
                            Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="Supports youtube.com/watch, youtu.be, embed, and m.youtube.com" />
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,14,0,0"
                            Orientation="Horizontal">
                            <Button
                                x:Name="PasteFromClipboardButton"
                                Margin="0,0,10,0"
                                Padding="14,8"
                                Command="{Binding PasteFromClipboardCommand}"
                                Content="Paste from clipboard" />
                            <Button
                                x:Name="FetchInfoButton"
                                Padding="18,8"
                                Background="{ThemeResource App.Accent}"
                                BorderThickness="0"
                                Command="{Binding FetchInfoCommand}"
                                Content="Fetch info"
                                FontWeight="SemiBold"
                                Foreground="White" />
                            <TextBlock
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#FFFF6B6B"
                                Text="Invalid URL"
                                Visibility="{Binding IsUrlValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="16"
                    Background="{ThemeResource App.Surface}"
                    BorderBrush="{ThemeResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsFetching, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontWeight="SemiBold"
                            Text="Loading preview..." />
                        <ProgressBar Height="8" IsIndeterminate="True" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="0"
                    Background="{ThemeResource App.Surface}"
                    BorderBrush="{ThemeResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Border
                                Height="158"
                                Background="#22000000"
                                CornerRadius="8" />
                            <Image
                                Height="158"
                                HorizontalAlignment="Stretch"
                                Stretch="UniformToFill"
                                Visibility="{Binding VideoInfo.HasThumbnail, Converter={StaticResource BoolToVis}}"
                                Source="{Binding VideoInfo.Thumbnail}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.5"
                                Text="No thumbnail"
                                Visibility="{Binding VideoInfo.HasThumbnail, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding VideoInfo.Title}"
                                TextWrapping="Wrap" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Opacity="0.8"
                                    Text="Channel:" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Opacity="0.8"
                                    Text="{Binding VideoInfo.ChannelName, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Opacity="0.8"
                                    Text="Duration:" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Opacity="0.8"
                                    Text="{Binding VideoInfo.DurationDisplay, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,14,0,4"
                                FontWeight="SemiBold"
                                Text="Stream / format" />
                            <ComboBox
                                MinWidth="320"
                                HorizontalAlignment="Left"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding VideoInfo.Formats}"
                                SelectedItem="{Binding VideoInfo.SelectedFormat, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    Margin="0,14,0,0"
                    Padding="16"
                    Background="{ThemeResource App.Surface}"
                    BorderBrush="{ThemeResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="0,0,0,12"
                            FontWeight="SemiBold"
                            Text="Download options" />
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Content="Download video"
                                IsChecked="{Binding Options.DownloadVideo, Mode=TwoWay}" />
                            <CheckBox
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                Content="Download thumbnail"
                                IsChecked="{Binding Options.DownloadThumbnail, Mode=TwoWay}" />
                            <CheckBox
                                Grid.Column="2"
                                Content="Download subtitles"
                                IsChecked="{Binding Options.DownloadSubtitles, Mode=TwoWay}" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Opacity="0.75"
                                    Text="Container" />
                                <ComboBox
                                    ItemsSource="{Binding Options.VideoContainers}"
                                    SelectedItem="{Binding Options.SelectedVideoContainer, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Opacity="0.75"
                                    Text="Quality" />
                                <ComboBox
                                    ItemsSource="{Binding Options.QualityOptions}"
                                    SelectedItem="{Binding Options.SelectedQuality, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Opacity="0.75"
                                    Text="Subtitle language" />
                                <ComboBox
                                    IsEnabled="{Binding IsSubtitlePickerEnabled}"
                                    ItemsSource="{Binding VideoInfo.SubtitleLanguages}"
                                    SelectedItem="{Binding VideoInfo.SelectedSubtitleLanguage, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="4"
                    Margin="0,14,0,0"
                    Padding="16"
                    Background="{ThemeResource App.Surface}"
                    BorderBrush="{ThemeResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Save to folder" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                MinHeight="36"
                                Padding="8,4"
                                VerticalContentAlignment="Center"
                                Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Name="BrowseOutputFolderButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="16,8"
                                Command="{Binding BrowseOutputFolderCommand}"
                                Content="Browse..." />
                        </Grid>
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="#FFFF6B6B"
                            Text="Folder not found - pick a valid path."
                            Visibility="{Binding IsOutputFolderValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="5"
                    Margin="0,14,0,0"
                    Padding="16"
                    Background="{ThemeResource App.Surface}"
                    BorderBrush="{ThemeResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontWeight="SemiBold"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                Height="12"
                                Maximum="100"
                                Minimum="0"
                                IsIndeterminate="{Binding IsProgressIndeterminate}"
                                Value="{Binding ProgressPercent, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            x:Name="DownloadButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,14,0,0"
                            Padding="28,12"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource App.Accent}"
                            BorderThickness="0"
                            Command="{Binding DownloadCommand}"
                            Content="Download"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White" />
                        <Button
                            x:Name="CancelDownloadButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,14,0,0"
                            Padding="20,12"
                            Command="{Binding CancelDownloadCommand}"
                            Content="Cancel" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="6"
                    Margin="0,14,0,0"
                    MinHeight="200"
                    Padding="12"
                    Background="{ThemeResource App.Surface}"
                    BorderBrush="{ThemeResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Activity" />
                            <Button
                                x:Name="ClearLogButton"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="12,6"
                                Command="{Binding ClearLogCommand}"
                                Content="Clear log" />
                        </Grid>
                        <ListView
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding ActivityLog}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,2"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{Binding IsStdErr, Converter={StaticResource StdErrToBrush}}"
                                        Text="{Binding FormattedLine}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="2,0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
