<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <x:String x:Key="Icon.Theme">light</x:String>
            <BitmapImage x:Key="Icon.Brand.44" UriSource="ms-appx:///Assets/AppLogo.png" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <x:String x:Key="Icon.Theme">dark</x:String>
            <BitmapImage x:Key="Icon.Brand.44" UriSource="ms-appx:///Assets/AppLogo.png" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
